{
  "name": "arky-sdk",
  "version": "0.26.114",
  "description": "Official TypeScript SDK for Arky - website backend for custom frontends",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./admin": {
      "import": {
        "types": "./dist/admin.d.ts",
        "default": "./dist/admin.js"
      },
      "require": {
        "types": "./dist/admin.d.cts",
        "default": "./dist/admin.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./storefront": {
      "import": {
        "types": "./dist/storefront.d.ts",
        "default": "./dist/storefront.js"
      },
      "require": {
        "types": "./dist/storefront.d.cts",
        "default": "./dist/storefront.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/types.d.ts",
        "default": "./dist/types.js"
      },
      "require": {
        "types": "./dist/types.d.cts",
        "default": "./dist/types.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "check:public-surface": "node scripts/check-public-surface.mjs",
    "prebuild": "node scripts/check-no-any.mjs && npm run check:public-surface",
    "build": "tsup",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "prepare": "npm run build"
  },
  "keywords": [
    "arky",
    "sdk",
    "cms",
    "ecommerce",
    "reservations",
    "newsletter",
    "analytics",
    "typescript"
  ],
  "author": "0xDjole",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xDjole/arky-sdk.git"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.13.0",
    "nanostores": "^1.3.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.107.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
